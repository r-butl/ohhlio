// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  username  String    @unique
  profileImageId String? @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  assets    Asset[]
  projects  Project[]
  notes     Note[]
  description String?
  profileImage Asset? @relation("UserProfileImage", fields: [profileImageId], references: [id])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  headerPhotoId String? @unique
  userId      String
  isPublic    Boolean  @default(false)
  items       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headerPhoto Asset?   @relation("ProjectHeaderPhoto", fields: [headerPhotoId], references: [id])
  assets      ProjectAsset[]
}

model Asset {
  id        String   @id @default(cuid())
  filename  String
  filePath  String
  mimeType  String
  fileSize  Int
  type      String
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headerForProject Project? @relation("ProjectHeaderPhoto")
  profileForUser   User?    @relation("UserProfileImage")
  projects         ProjectAsset[]
}

model ProjectAsset {
  projectId String
  assetId   String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([projectId, assetId])
}

model Note {
  id        String   @id @default(cuid())
  body      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
